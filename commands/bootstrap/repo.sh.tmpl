set -euo pipefail
url={{.URL}}
ref={{.Ref}}
name="$(basename "$url" .git)"
dest="$HOME/$name"
if [ -d "$dest/.git" ]; then
  echo "repo $name already present; fetching"
  git -C "$dest" fetch --all --tags --prune
else
  git clone "$url" "$dest"
fi
{{- if .Detach}}
# A clone fetches no pull request refs and maybe not the commit. Fetch from
# the URL, whatever the guest named its remote, into a ref of our own that
# another fetch cannot replace before the checkout.
git -C "$dest" fetch "$url" "+$ref:refs/avr/checkout"
git -C "$dest" checkout --detach refs/avr/checkout
{{- else}}
# Check out only a branch: git resolves a bare name to a same-named tag or a
# path unless the local branch exists, and switch never takes a path. An
# existing local branch is switched to as it is. A new one tracks the remote
# whose URL is --repo; when no remote is, it is fetched from the URL and
# tracks only a remote that has it at the fetched commit.
if [ -n "$ref" ]; then
  if ! git -C "$dest" show-ref --verify --quiet "refs/heads/$ref"; then
    # Spellings of one URL: file:// or not, a trailing slash or .git.
    same_url() {
      local a=${1#file://} b=${2#file://}
      a=${a%/} b=${b%/}
      [ "${a%.git}" = "${b%.git}" ]
    }
    # A single-branch clone's fetch refspec leaves the branch out; add it so
    # later fetches update the upstream and $ref@{upstream} resolves.
    track() {
      git -C "$dest" config "branch.$ref.remote" "$1"
      git -C "$dest" config "branch.$ref.merge" "refs/heads/$ref"
      if ! git -C "$dest" rev-parse -q --verify "$ref@{upstream}" >/dev/null; then
        git -C "$dest" remote set-branches --add "$1" "$ref"
      fi
    }
    remote=""
    for candidate in $(git -C "$dest" remote); do
      if same_url "$(git -C "$dest" remote get-url "$candidate")" "$url"; then remote=$candidate; break; fi
    done
    if [ -n "$remote" ]; then
      if ! git -C "$dest" show-ref --verify --quiet "refs/remotes/$remote/$ref" &&
        ! git -C "$dest" fetch "$remote" "+refs/heads/$ref:refs/remotes/$remote/$ref"; then
        echo "could not fetch branch $ref from $url" >&2
        exit 1
      fi
      git -C "$dest" branch -q --no-track "$ref" "refs/remotes/$remote/$ref"
      track "$remote"
    else
      if ! git -C "$dest" fetch "$url" "refs/heads/$ref:refs/heads/$ref"; then
        echo "could not fetch branch $ref from $url" >&2
        exit 1
      fi
      commit=$(git -C "$dest" rev-parse "refs/heads/$ref")
      same=0 matching=""
      for candidate in $(git -C "$dest" remote); do
        if [ "$(git -C "$dest" rev-parse -q --verify "refs/remotes/$candidate/$ref")" = "$commit" ]; then
          same=$((same + 1)) matching=$candidate
        fi
      done
      if [ "$same" -eq 1 ]; then
        track "$matching"
      else
        echo "branch $ref has no upstream: no remote is $url" >&2
      fi
    fi
  fi
  git -C "$dest" switch "$ref"
fi
{{- end}}
echo "repo ready at $dest"
