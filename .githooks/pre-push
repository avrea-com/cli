#!/usr/bin/env bash
# Native release tags must match the version in the tagged source.
# Release CI generates and scans SBOMs from the tested native artifacts.
set -euo pipefail

while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in
    refs/tags/v[0-9]*)
      [ "$local_sha" != 0000000000000000000000000000000000000000 ] || continue
      candidate="${remote_ref#refs/tags/}"
      if ! version=$(git show "$local_sha:internal/version/VERSION" 2>/dev/null); then
        echo "pre-push: tagged source has no native version file" >&2
        exit 1
      fi
      if [ "$candidate" != "v$version" ]; then
        echo "pre-push: $candidate does not match native version $version" >&2
        exit 1
      fi
      ;;
  esac
done
